// Direct ports of twelve LangArena workloads. See README.md for provenance,
// coverage and timing. Algorithms execute here; libc supplies only timing and
// the original seven-decimal float checksum formatting. Bounds checks stay on.
import std.env
import std.libc
import std.sort

struct Timespec { seconds: i64, nanos: i64 }
extern fn clock_gettime(clock: i32, out: *Timespec) -> i32

fn now() -> i64 {
    var out = Timespec { seconds: 0, nanos: 0 }
    unsafe { clock_gettime(1, &out) }
    out.seconds * 1000000000 + out.nanos
}

fn bytes_checksum(bytes: Vec(u8)) -> u32 {
    var hash: u32 = 5381
    for ch in bytes { hash = hash *% 33 +% ch as u32 }
    hash
}

fn float_checksum(value: f64) -> u32 {
    var buffer = Vec(u8).filled(64, 0)
    let length = unsafe { libc.snprintf(buffer.as_slice().ptr, 64, "%.7f\0".ptr, value) } as i64
    var hash: u32 = 5381
    for i in 0..length { hash = hash *% 33 +% buffer[i] as u32 }
    hash
}

struct Bench {
    name: str
    n: i64
    height: i64
    seed: i64
    result: u32
    bytes: Vec(u8)
    numbers: Vec(i32)
    u: Vec(f64)
    v: Vec(f64)
    a: Vec(Vec(f64))
    b: Vec(Vec(f64))
}

fn next_int(inout seed: i64, max: i64) -> i64 {
    seed = (seed * 3877 + 29573) % 139968
    seed * max / 139968
}

fn matrix(n: i64) -> Vec(Vec(f64)) {
    let scale = 1.0 / n as f64 / n as f64
    var rows = Vec(Vec(f64)).new()
    for i in 0..n {
        var row = Vec(f64).filled(n, 0.0)
        for j in 0..n { row[j] = scale * (i - j) as f64 * (i + j) as f64 }
        rows.push(row)
    }
    rows
}

fn prepare(name: str, n: i64, height: i64) -> Bench {
    var state = Bench {
        name: name, n: n, height: height, seed: 42, result: 0,
        bytes: Vec(u8).new(), numbers: Vec(i32).new(),
        u: Vec(f64).new(), v: Vec(f64).new(),
        a: Vec(Vec(f64)).new(), b: Vec(Vec(f64)).new()
    }
    if name == "Sort::Quick" || name == "Sort::Merge" || name == "Sort::Self" {
        for i in 0..n { state.numbers.push(next_int(&state.seed, 1000000) as i32) }
    } else if name == "Hash::SHA256" || name == "Hash::CRC32" {
        for i in 0..n { state.bytes.push(next_int(&state.seed, 256) as u8) }
    } else if name == "CLBG::Spectralnorm" {
        state.u = Vec(f64).filled(n, 1.0)
        state.v = Vec(f64).filled(n, 1.0)
    } else if name == "Matmul::Single" {
        state.a = matrix(n)
        state.b = matrix(n)
    }
    state
}

fn sieve(limit: i64) -> u32 {
    if limit < 2 { return 0 }
    var primes = Vec(u8).filled(limit + 1, 1)
    primes[0] = 0
    primes[1] = 0
    let root = sqrt(limit as f64) as i64
    for p in 2..root + 1 {
        if primes[p] == 1 {
            var multiple = p * p
            while multiple <= limit { primes[multiple] = 0; multiple += p }
        }
    }
    var last: u32 = 2
    var count: u32 = 1
    var i = 3
    while i <= limit {
        if primes[i] == 1 { last = i as u32; count += 1 }
        i += 2
    }
    last + count
}

fn quick_sort(inout values: Vec(i32), low: i64, high: i64) {
    if low >= high { return }
    let pivot = values[(low + high) / 2]
    var i = low
    var j = high
    while i <= j {
        while values[i] < pivot { i += 1 }
        while values[j] > pivot { j -= 1 }
        if i <= j {
            let temp = values[i]
            values[i] = values[j]
            values[j] = temp
            i += 1
            j -= 1
        }
    }
    quick_sort(&values, low, j)
    quick_sort(&values, i, high)
}

fn merge_sort(inout values: Vec(i32), inout temp: Vec(i32), left: i64, right: i64) {
    if left >= right { return }
    let mid = (left + right) / 2
    merge_sort(&values, &temp, left, mid)
    merge_sort(&values, &temp, mid + 1, right)
    for k in left..right + 1 { temp[k] = values[k] }
    var i = left
    var j = mid + 1
    var k = left
    while i <= mid && j <= right {
        if temp[i] <= temp[j] { values[k] = temp[i]; i += 1 }
        else { values[k] = temp[j]; j += 1 }
        k += 1
    }
    while i <= mid { values[k] = temp[i]; i += 1; k += 1 }
}

fn sort_run(inout state: Bench) {
    var sorted = state.numbers.clone()
    if state.name == "Sort::Quick" { quick_sort(&sorted, 0, state.n - 1) }
    else if state.name == "Sort::Merge" {
        var temp = Vec(i32).filled(state.n, 0)
        merge_sort(&sorted, &temp, 0, state.n - 1)
    } else { sort.sort(i32, &sorted) }
    let first = next_int(&state.seed, state.n)
    let second = next_int(&state.seed, state.n)
    state.result +%= state.numbers[first] as u32 +% sorted[second] as u32
}

fn hash_run(inout state: Bench) {
    let ch = next_int(&state.seed, 256) as u8
    let index = next_int(&state.seed, state.n)
    state.bytes[index] = ch
    if state.name == "Hash::SHA256" {
        // This is LangArena's custom eight-lane hash, not cryptographic SHA256.
        var hashes = Vec(u32).new()
        hashes.push(0x6a09e667); hashes.push(0xbb67ae85)
        hashes.push(0x3c6ef372); hashes.push(0xa54ff53a)
        hashes.push(0x510e527f); hashes.push(0x9b05688c)
        hashes.push(0x1f83d9ab); hashes.push(0x5be0cd19)
        for i in 0..state.n {
            var hash = hashes[i % 8]
            hash = (hash << 5) +% hash +% state.bytes[i] as u32
            hashes[i % 8] = (hash +% (hash << 10)) ^ (hash >> 6)
        }
        let h = hashes[0]
        let reversed = (h >> 24) | ((h >> 8) & 0x0000ff00) |
                       ((h << 8) & 0x00ff0000) | (h << 24)
        state.result +%= reversed
    } else {
        var crc: u32 = 0xffffffff
        for byte in state.bytes {
            crc ^= byte as u32
            for bit in 0..8 {
                if (crc & 1) != 0 { crc = (crc >> 1) ^ 0xedb88320 }
                else { crc >>= 1 }
            }
        }
        state.result +%= crc ^ 0xffffffff
    }
}

struct TreeNode {
    left: Option(Box(TreeNode))
    right: Option(Box(TreeNode))
    item: i32
}

fn tree(item: i32, depth: i64) -> Box(TreeNode) {
    var node = Box(TreeNode).new(TreeNode { left: None, right: None, item: item })
    if depth > 0 {
        let shift = 1 as i32 << (depth - 1)
        node.left = Some(tree(item - shift, depth - 1))
        node.right = Some(tree(item + shift, depth - 1))
    }
    node
}

fn tree_sum(node: Box(TreeNode)) -> u32 {
    var total = node.item as u32 +% 1
    match node.left { Some(child) => { total +%= tree_sum(child) }; None => {} }
    match node.right { Some(child) => { total +%= tree_sum(child) }; None => {} }
    total
}

struct ArenaNode { item: i32, left: i32, right: i32 }

fn arena_tree(inout nodes: Vec(ArenaNode), item: i32, depth: i64) -> i32 {
    let index = nodes.len() as i32
    nodes.push(ArenaNode { item: item, left: -1, right: -1 })
    if depth > 0 {
        let shift = 1 as i32 << (depth - 1)
        let left = arena_tree(&nodes, item - shift, depth - 1)
        let right = arena_tree(&nodes, item + shift, depth - 1)
        nodes[index as i64].left = left
        nodes[index as i64].right = right
    }
    index
}

fn arena_sum(nodes: Vec(ArenaNode), index: i32) -> u32 {
    let node = nodes[index as i64]
    var total = node.item as u32 +% 1
    if node.left >= 0 { total +%= arena_sum(nodes, node.left) }
    if node.right >= 0 { total +%= arena_sum(nodes, node.right) }
    total
}

fn fannkuch(n: i64) -> u32 {
    var perm1 = Vec(i32).filled(32, 0)
    var perm = Vec(i32).filled(32, 0)
    var count = Vec(i32).filled(32, 0)
    for i in 0..n { perm1[i] = i as i32 }
    var maximum: i32 = 0
    var checksum: i32 = 0
    var perm_count = 0
    var r = n
    while true {
        while r > 1 { count[r - 1] = r as i32; r -= 1 }
        for i in 0..n { perm[i] = perm1[i] }
        var flips: i32 = 0
        var k = perm[0] as i64
        while k != 0 {
            for i in 0..(k + 1) >> 1 {
                let j = k - i
                let value = perm[i]; perm[i] = perm[j]; perm[j] = value
            }
            flips += 1
            k = perm[0] as i64
        }
        if flips > maximum { maximum = flips }
        if perm_count % 2 == 0 { checksum += flips } else { checksum -= flips }
        while true {
            if r == n { return (checksum * 100 + maximum) as u32 }
            let first = perm1[0]
            for i in 0..r { perm1[i] = perm1[i + 1] }
            perm1[r] = first
            count[r] -= 1
            if count[r] > 0 { break }
            r += 1
        }
        perm_count += 1
    }
    0
}

fn mandelbrot(inout state: Bench) {
    let w = state.n
    let h = state.height
    var header = String.from("P4\n")
    header.push_str(w.to_string().as_str())
    header.push_str(" ")
    header.push_str(h.to_string().as_str())
    header.push_str("\n")
    for ch in header.as_str() { state.bytes.push(ch) }
    var bit_num = 0
    var byte_acc: u8 = 0
    for y in 0..h {
        let ci = 2.0 * y as f64 / h as f64 - 1.0
        for x in 0..w {
            let cr = 2.0 * x as f64 / w as f64 - 1.5
            var zr = 0.0; var zi = 0.0
            var tr = 0.0; var ti = 0.0
            var i = 0
            while i < 50 && tr + ti <= 4.0 {
                zi = 2.0 * zr * zi + ci
                zr = tr - ti + cr
                tr = zr * zr
                ti = zi * zi
                i += 1
            }
            byte_acc <<= 1
            if tr + ti <= 4.0 { byte_acc |= 1 }
            bit_num += 1
            if bit_num == 8 {
                state.bytes.push(byte_acc); byte_acc = 0; bit_num = 0
            } else if x == w - 1 {
                byte_acc <<= (8 - (w % 8)) as u8
                state.bytes.push(byte_acc); byte_acc = 0; bit_num = 0
            }
        }
    }
}

fn eval_a(i: i64, j: i64) -> f64 {
    1.0 / ((i + j) as f64 * ((i + j) as f64 + 1.0) / 2.0 + i as f64 + 1.0)
}

fn eval_times(values: Vec(f64), transpose: bool) -> Vec(f64) {
    let n = values.len()
    var out = Vec(f64).filled(n, 0.0)
    for i in 0..n {
        var sum = 0.0
        for j in 0..n {
            let element = if transpose { eval_a(j, i) } else { eval_a(i, j) }
            sum += element * values[j]
        }
        out[i] = sum
    }
    out
}

fn matmul(inout state: Bench) {
    let n = state.n
    var transposed = Vec(Vec(f64)).new()
    for j in 0..n {
        var row = Vec(f64).filled(n, 0.0)
        for i in 0..n { row[i] = state.b[i][j] }
        transposed.push(row)
    }
    var result = Vec(Vec(f64)).new()
    for i in 0..n {
        var row = Vec(f64).filled(n, 0.0)
        for j in 0..n {
            var sum = 0.0
            for k in 0..n { sum += state.a[i][k] * transposed[j][k] }
            row[j] = sum
        }
        result.push(row)
    }
    state.result +%= float_checksum(result[n >> 1][n >> 1])
}

fn run(inout state: Bench) {
    let name = state.name
    if name == "Etc::Sieve" { state.result +%= sieve(state.n) }
    else if name == "Sort::Quick" || name == "Sort::Merge" || name == "Sort::Self" { sort_run(&state) }
    else if name == "Hash::SHA256" || name == "Hash::CRC32" { hash_run(&state) }
    else if name == "Binarytrees::Obj" { state.result +%= tree_sum(tree(0, state.n)) }
    else if name == "Binarytrees::Arena" {
        var nodes = Vec(ArenaNode).with_capacity(1024)
        let root = arena_tree(&nodes, 0, state.n)
        state.result +%= arena_sum(nodes, root)
    } else if name == "CLBG::Fannkuchredux" { state.result +%= fannkuch(state.n) }
    else if name == "CLBG::Mandelbrot" { mandelbrot(&state) }
    else if name == "CLBG::Spectralnorm" {
        let temp_v = eval_times(state.u, false)
        var next_v = eval_times(temp_v, true)
        let temp_u = eval_times(next_v, false)
        state.u = eval_times(temp_u, true)
        state.v = next_v
    } else if name == "Matmul::Single" { matmul(&state) }
    else { panic("unsupported benchmark") }
}

fn checksum(state: Bench) -> u32 {
    if state.name == "CLBG::Mandelbrot" { return bytes_checksum(state.bytes) }
    if state.name == "CLBG::Spectralnorm" {
        var vbv = 0.0; var vv = 0.0
        for i in 0..state.n { vbv += state.u[i] * state.v[i]; vv += state.v[i] * state.v[i] }
        return float_checksum(sqrt(vbv / vv))
    }
    state.result
}

fn main() {
    let args = env.args()
    let name = args[1]
    let iterations = args[2].parse_int().unwrap()
    let warmup = args[3].parse_int().unwrap()
    let n = args[4].parse_int().unwrap()
    let height = args[5].parse_int().unwrap()
    let expected = args[6].parse_int().unwrap() as u32
    var state = prepare(name, n, height)
    for i in 0..warmup { run(&state) }
    state.seed = 42
    let start = now()
    for i in 0..iterations { run(&state) }
    let elapsed = now() - start
    let actual = checksum(state)
    println(actual)
    println(elapsed)
    if actual != expected { panic("LangArena checksum mismatch") }
}
